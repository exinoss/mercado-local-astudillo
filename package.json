{
  "name": "mercado-local-astro",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:background": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "build": "astro build",
    "test": "bun test src/ && node --test .codex/hooks/load-memory.test.cjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "check:repo": "node scripts/verify-repository.mjs",
    "check:dist": "node scripts/verify-dist.mjs",
    "check": "bun run check:repo && bun run test && bun run build && bun run check:dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "tailwindcss": "^4.3.3"
  },
  "trustedDependencies": ["esbuild"]
}
