---
import Icon from "./Icon.astro";
---

<header class="sticky top-0 z-50 bg-white shadow-sm">

  <div class="bg-[#072f63] text-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-2 text-xs">
      <span class="inline-flex items-center gap-1.5"><Icon name="map-pin" size={14} /> San Lorenzo, Esmeraldas</span>

      <span>
        Una iniciativa del Municipio de San Lorenzo y la Cámara de Comercio
      </span>
    </div>
  </div>

  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-4 px-6 py-4 lg:grid-cols-[220px_1fr_auto]">

    <a href="/" class="flex items-center gap-3">

      <div class="grid h-12 w-12 place-items-center rounded-2xl bg-[#ffc61a] text-2xl">
        <Icon name="cart" size={28} class="text-[#072f63]" />
      </div>

      <div>
        <strong class="block text-xl font-black text-[#0a3b78]">
          Mercado Local
        </strong>

        <span class="text-sm font-semibold text-slate-500">
          San Lorenzo
        </span>
      </div>

    </a>


    <div class="flex overflow-hidden rounded-2xl border-2 border-[#ffc61a] bg-white shadow-sm">

      <input
        type="search"
        placeholder="Buscar productos, marcas o comercios..."
        class="w-full px-4 py-3 outline-none"
      />

      <button
        class="bg-[#ffc61a] px-5 text-xl text-[#072f63]"
        aria-label="Buscar productos"
      >
        <Icon name="search" size={22} />
      </button>

    </div>


    <div class="flex items-center gap-4 text-sm font-black text-[#0a3b78]">

      <button class="inline-flex items-center gap-1.5 whitespace-nowrap">
        <Icon name="user" size={18} /> Ingresar
      </button>

      <button class="inline-flex items-center gap-1.5 whitespace-nowrap">
        <Icon name="receipt" size={18} /> Mis compras
      </button>

      <button class="inline-flex items-center gap-1.5 whitespace-nowrap">
        <Icon name="cart" size={18} /> Carrito
        <span class="ml-1 rounded-full bg-red-500 px-2 py-1 text-xs text-white">
          0
        </span>
      </button>

    </div>

  </div>


  <nav class="bg-gradient-to-r from-[#ffc61a] to-[#ffe36d]">

    <div class="mx-auto flex max-w-7xl gap-8 overflow-x-auto px-6 py-3 text-sm font-black text-[#17375f]">

      <a href="#categorias">Categorías</a>
      <a href="#productos">Ofertas</a>
      <a href="#comercios">Comercios</a>
      <a href="#productos-locales">Productos locales</a>
      <a href="#vender">Vender</a>
      <a href="#ayuda">Ayuda</a>

    </div>

  </nav>

</header>
